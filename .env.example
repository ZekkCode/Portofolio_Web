# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE: ZekkTech Portfolio
# Salin berkas ini menjadi .env.local untuk penggunaan lokal atau masukkan ke Vercel Environment Variables.
# JANGAN PERNAH MENYIMPAN ATAU MENG-COMMIT KUNCI ASLI KE DALAM FILE INI.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Domain Publik & Canonical URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://zakariamp.vercel.app

# ------------------------------------------------------------------------------
# 2. Administrator & Autentikasi Server-Side
# ------------------------------------------------------------------------------
# Email pemilik/administrator untuk akses panel /admin
ADMIN_EMAIL=zakariamujur6@gmail.com
# Kata sandi akses administrator langsung (minimal 16 karakter acak)
ADMIN_PASSWORD=your_secure_admin_password_min_16_chars
# Secret key penandatanganan cookie sesi admin (HMAC-SHA256, 32+ karakter)
ADMIN_SESSION_SECRET=your_32_char_random_hmac_secret_string

# ------------------------------------------------------------------------------
# 3. Cloudflare R2 Storage (Penyimpanan Aset, Avatar, & PDF CV)
# ------------------------------------------------------------------------------
# Dapatkan dari Cloudflare Dashboard > R2 > Manage R2 API Tokens > Create API Token
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=portofolio-zekk
# Domain publik bucket R2 (kosongkan jika Public Access Disabled; sistem otomatis menggunakan backend proxy / presigned URL)
R2_PUBLIC_DOMAIN=

# ------------------------------------------------------------------------------
# 4. Supabase Cloud Database (Penyimpanan Konfigurasi & Page Views)
# ------------------------------------------------------------------------------
# Dapatkan dari Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# 5. Variabel Opsional / Headless Testing
# ------------------------------------------------------------------------------
# BASE_URL=http://localhost:3000
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
