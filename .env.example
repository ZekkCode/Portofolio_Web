# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE: ZekkTech Portfolio
# Salin berkas ini menjadi .env.local untuk penggunaan lokal atau masukkan ke Vercel Environment Variables.
# JANGAN PERNAH MENYIMPAN ATAU MENG-COMMIT KUNCI ASLI KE DALAM FILE INI.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloudflare R2 Storage (Penyimpanan Gambar, Hero Avatar, Logo & PDF CV)
# ------------------------------------------------------------------------------
# Dapatkan dari Cloudflare Dashboard > R2 > Manage R2 API Tokens > Create API Token
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=zekk-portfolio
# Domain publik bucket R2 (dari Bucket Settings > Public access > R2.dev / Custom Domain)
R2_PUBLIC_DOMAIN=https://pub-xxxx.r2.dev

# ------------------------------------------------------------------------------
# 2. Supabase Cloud Database (Penyimpanan Konfigurasi Portofolio & Page Views)
# ------------------------------------------------------------------------------
# Dapatkan dari Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# 3. Variabel Opsional / Testing
# ------------------------------------------------------------------------------
# BASE_URL=http://localhost:3000
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
